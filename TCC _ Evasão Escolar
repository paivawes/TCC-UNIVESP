,"    '2019_taxas': {'nome': '/content/drive/MyDrive/UNIVESP/Parte Técnica/dados_brutos/2019/tx_rend_municipios_2019.csv', 'sep': ';', 'enc': 'latin1'},\n","    '2019_infra': {'nome': '/content/drive/MyDrive/UNIVESP/Parte Técnica/dados_brutos/2019/microdados_ed_basica_2019.csv', 'sep': ';', 'enc': 'latin1'}\n","}\n","\n","ID_MUN_SP = 3550308\n","\n","def converter_numerico(valor):\n","    \"\"\"Converte valores com vírgula ou strings vazias para número\"\"\"\n","    if pd.isna(valor) or str(valor).strip() in ['--', '', 'nan']:\n","        return np.nan\n","    if isinstance(valor, str):\n","        # Remove espaços e troca vírgula por ponto\n","        v = valor.strip().replace(',', '.')\n","        try:\n","            return float(v)\n","        except:\n","            return np.nan\n","    return float(valor)\n","\n","# --- PROCESSAMENTO ---\n","dados = {}\n","\n","for chave, config in arquivos.items():\n","    print(f\"⏳ Processando {config['nome']}...\")\n","    df = pd.read_csv(config['nome'], sep=config['sep'], encoding=config['enc'], low_memory=False)\n","\n","    # Limpeza básica dos nomes das colunas originais (remover espaços extras)\n","    df.columns = [c.strip() for c in df.columns]\n","\n","    # Mapeamento Específico para cada ano/tipo\n","    if chave == '2009_taxas':\n","        df = df.rename(columns={\n","            'Código do Município': 'ID_MUNICIPIO',\n","            'Localização': 'LOCALIZACAO',\n","            'Rede': 'REDE',\n","            'Total Abandono - Médio': 'TAXA_ABANDONO'\n","        })\n","    elif chave == '2019_taxas':\n","        # Em 2019, os nomes vêm com problemas de acento (latin1)\n","        # Vamos mapear pela ordem ou pelo nome detectado\n","        mapeamento_19 = {}\n","        for col in df.columns:\n","            c_upper = col.upper()\n","            if 'CÓDIGO' in c_upper or 'CDIGO' in c_upper: mapeamento_19[col] = 'ID_MUNICIPIO'\n","            elif 'LOCALIZA' in c_upper: mapeamento_19[col] = 'LOCALIZACAO'\n","            elif 'DEPEND' in c_upper: mapeamento_19[col] = 'REDE'\n","            elif col == 'Total': mapeamento_19[col] = 'TAXA_ABANDONO'\n","        df = df.rename(columns=mapeamento_19)\n","    elif chave == '2019_infra':\n","        df = df.rename(columns={'CO_MUNICIPIO': 'ID_MUNICIPIO'})\n","\n","    # Filtro para São Paulo\n","    if 'ID_MUNICIPIO' in df.columns:\n","        df = df[df['ID_MUNICIPIO'] == ID_MUN_SP].copy()\n","\n","    # Conversão da taxa\n","    if 'TAXA_ABANDONO' in df.columns:\n","        df['TAXA_ABANDONO'] = df['TAXA_ABANDONO'].apply(converter_numerico)\n","\n","    dados[chave] = df\n","\n","# --- RESULTADOS ---\n","df09 = dados['2009_taxas']\n","df19 = dados['2019_taxas']\n","\n","print(\"\\n✅ Processamento concluído com sucesso!\")\n","\n","# Verificação de segurança: filtrar apenas linhas de 'Total' para não misturar Rural/Urbana\n","aba_09 = df09[(df09['LOCALIZACAO'] == 'Total') & (df09['REDE'] == 'Estadual')]['TAXA_ABANDONO'].mean()\n","aba_19 = df19[(df19['LOCALIZACAO'] == 'Total') & (df19['REDE'] == 'Estadual')]['TAXA_ABANDONO'].mean()\n","\n","print(f\"\\n📊 Comparativo Abandono (Ensino Médio Estadual - SP):\")\n","print(f\"Ano 2009: {aba_09:.2f}%\")\n","print(f\"Ano 2019: {aba_19:.2f}%\")\n","print(f\"Diferença: {aba_19 - aba_09:.2f} pontos percentuais\")\n","\n","# Salvando a base de infraestrutura limpa para você usar\n","dados['2019_infra'].to_csv('infra_escolas_sp_2019.csv', index=False, sep=';', encoding='latin1')\n","print(\"\\n💾 Arquivo 'infra_escolas_sp_2019.csv' gerado.\")\n","\n"],"metadata":{"id":"vI5YD2hRRPDM","executionInfo":{"status":"aborted","timestamp":1779012687655,"user_tz":180,"elapsed":40,"user":{"displayName":"Douglas Bellini","userId":"12877567812401909233"}}},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from sklearn.tree import DecisionTreeClassifier, plot_tree\n","from sklearn.model_selection import train_test_split\n","\n","# 1. CARREGAMENTO E LIMPEZA\n","path_taxas = 'tx_rend_escolas_2019.csv'\n","path_infra = 'microdados_ed_basica_2019.csv'\n","\n","def clean_val(x):\n","    if pd.isna(x) or str(x).strip() in ['--', '', 'nan']: return np.nan\n","    try: return float(str(x).replace(',', '.'))\n","    except: return np.nan\n","\n","print(\"⏳ Processando cruzamento de dados...\")\n","df_yield = pd.read_csv(path_taxas, sep=';', encoding='latin1')\n","df_yield.columns = [c.strip() for c in df_yield.columns]\n","# Renomeando colunas críticas que costumam vir com erro de encoding\n","df_yield = df_yield.rename(columns={\n","    'CÃ³digo da Escola': 'CO_ENTIDADE',\n","    'Taxa de Abandono': 'TAXA_ABANDONO',\n","    'DependÃªncia Administrativa': 'REDE',\n","    'CÃ³digo do MunicÃ­pio': 'CO_MUNICIPIO'\n","})\n","\n","df_infra = pd.read_csv(path_infra, sep=';', encoding='latin1', low_memory=False)\n","features = ['IN_BIBLIOTECA', 'IN_LABORATORIO_INFORMATICA', 'IN_LABORATORIO_CIENCIAS',\n","            'IN_QUADRA_ESPORTES', 'IN_INTERNET', 'IN_REFEITORIO']\n","\n","# Filtrando SP e Rede Estadual\n","df_merged = pd.merge(df_yield, df_infra[['CO_ENTIDADE'] + features], on='CO_ENTIDADE')\n","df_merged = df_merged[(df_merged['CO_MUNICIPIO'] == 3550308) & (df_merged['REDE'] == 'Estadual')]\n","df_merged['TAXA_ABANDONO'] = df_merged['TAXA_ABANDONO'].apply(clean_val)\n","df_merged = df_merged.dropna(subset=['TAXA_ABANDONO'])\n","\n","# 2. MACHINE LEARNING (SCIKIT-LEARN)\n","# Alvo: 1 se abandono > média, 0 se menor\n","media = df_merged['TAXA_ABANDONO'].mean()\n","df_merged['ALVO'] = (df_merged['TAXA_ABANDONO'] > media).astype(int)\n","\n","X = df_merged[features]\n","y = df_merged['ALVO']\n","\n","clf = DecisionTreeClassifier(max_depth=3, random_state=42)\n","clf.fit(X, y)\n","\n","# 3. VISUALIZAÇÕES PARA O TCC\n","print(\"✅ Gerando gráficos...\")\n","\n","# Gráfico 1: Árvore de Decisão\n","plt.figure(figsize=(20,10))\n","plot_tree(clf, feature_na